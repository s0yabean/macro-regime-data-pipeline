# Copy to .env (never committed) or export in your shell. All optional.
# yfinance needs no key. Without these, the matching ingester is skipped or exits with a message.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# CoinGecko. Paid keys use the default pro base URL; for a free demo key also set
# COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_API_BASE=https://pro-api.coingecko.com/api/v3

# Coinranking, for the long-history crypto export
COINRANKING_API_KEY=
